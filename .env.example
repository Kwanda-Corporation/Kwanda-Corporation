# Contact form / SMTP settings (Netlify Functions)
# Copy these to Netlify → Site configuration → Environment variables.
# The values mirror the Katisha project; SMTP_PASS is a Gmail app password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
